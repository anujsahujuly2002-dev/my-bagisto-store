            "EcomForYou\\Inventory\\": "packages/EcomForYou/Inventory/src",
            "EcomForYou\\MagicAI\\": "packages/EcomForYou/MagicAI/src",
            "EcomForYou\\Marketing\\": "packages/EcomForYou/Marketing/src",
            "EcomForYou\\Notification\\": "packages/EcomForYou/Notification/src",
            "EcomForYou\\Omnibus\\": "packages/EcomForYou/Omnibus/src",
            "EcomForYou\\PayGlocal\\": "packages/EcomForYou/PayGlocal/src",
            "EcomForYou\\PayU\\": "packages/EcomForYou/PayU/src",
            "EcomForYou\\Payment\\": "packages/EcomForYou/Payment/src",
            "EcomForYou\\Paypal\\": "packages/EcomForYou/Paypal/src",
            "EcomForYou\\PhonePe\\": "packages/EcomForYou/PhonePe/src",
            "EcomForYou\\Product\\": "packages/EcomForYou/Product/src",
            "EcomForYou\\RMA\\": "packages/EcomForYou/RMA/src",
            "EcomForYou\\Razorpay\\": "packages/EcomForYou/Razorpay/src",
            "EcomForYou\\Rule\\": "packages/EcomForYou/Rule/src",
            "EcomForYou\\Sales\\": "packages/EcomForYou/Sales/src",
            "EcomForYou\\Shipping\\": "packages/EcomForYou/Shipping/src",
            "EcomForYou\\Shop\\": "packages/EcomForYou/Shop/src",
            "EcomForYou\\Sitemap\\": "packages/EcomForYou/Sitemap/src",
            "EcomForYou\\SocialLogin\\": "packages/EcomForYou/SocialLogin/src",
            "EcomForYou\\SocialShare\\": "packages/EcomForYou/SocialShare/src",
            "EcomForYou\\Stripe\\": "packages/EcomForYou/Stripe/src",
            "EcomForYou\\Tax\\": "packages/EcomForYou/Tax/src",
            "EcomForYou\\Tenancy\\": "packages/EcomForYou/Tenancy/src",
            "EcomForYou\\Theme\\": "packages/EcomForYou/Theme/src",
            "EcomForYou\\User\\": "packages/EcomForYou/User/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "EcomForYou\\Admin\\Tests\\": "packages/EcomForYou/Admin/tests",
            "EcomForYou\\Category\\Tests\\": "packages/EcomForYou/Category/tests",
            "EcomForYou\\Checkout\\Tests\\": "packages/EcomForYou/Checkout/tests",
            "EcomForYou\\Core\\Tests\\": "packages/EcomForYou/Core/tests",
            "EcomForYou\\Customer\\Tests\\": "packages/EcomForYou/Customer/tests",
            "EcomForYou\\DataGrid\\Tests\\": "packages/EcomForYou/DataGrid/tests",
            "EcomForYou\\EUWithdrawal\\Tests\\": "packages/EcomForYou/EUWithdrawal/tests",
            "EcomForYou\\FPC\\Tests\\": "packages/EcomForYou/FPC/tests",
            "EcomForYou\\Installer\\Tests\\": "packages/EcomForYou/Installer/tests",
            "EcomForYou\\Marketing\\Tests\\": "packages/EcomForYou/Marketing/tests",
            "EcomForYou\\Omnibus\\Tests\\": "packages/EcomForYou/Omnibus/tests",
            "EcomForYou\\PayGlocal\\Tests\\": "packages/EcomForYou/PayGlocal/tests",
            "EcomForYou\\Paypal\\Tests\\": "packages/EcomForYou/Paypal/tests",
            "EcomForYou\\PayU\\Tests\\": "packages/EcomForYou/PayU/tests",
            "EcomForYou\\Payment\\Tests\\": "packages/EcomForYou/Payment/tests",
            "EcomForYou\\PhonePe\\Tests\\": "packages/EcomForYou/PhonePe/tests",
            "EcomForYou\\Product\\Tests\\": "packages/EcomForYou/Product/tests",
            "EcomForYou\\Razorpay\\Tests\\": "packages/EcomForYou/Razorpay/tests",
            "EcomForYou\\Rule\\Tests\\": "packages/EcomForYou/Rule/tests",
            "EcomForYou\\Sales\\Tests\\": "packages/EcomForYou/Sales/tests",
            "EcomForYou\\Shipping\\Tests\\": "packages/EcomForYou/Shipping/tests",
            "EcomForYou\\Shop\\Tests\\": "packages/EcomForYou/Shop/tests",
            "EcomForYou\\Stripe\\Tests\\": "packages/EcomForYou/Stripe/tests",
            "EcomForYou\\Tax\\Tests\\": "packages/EcomForYou/Tax/tests",
            "EcomForYou\\Tenancy\\Tests\\": "packages/EcomForYou/Tenancy/tests",
            "EcomForYou\\Theme\\Tests\\": "packages/EcomForYou/Theme/tests"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/socialite"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/bagisto/bagisto/issues",
        "forum": "https://forums.bagisto.com",
        "source": "https://github.com/bagisto/bagisto",
        "docs": "https://devdocs.bagisto.com"
    }
}
