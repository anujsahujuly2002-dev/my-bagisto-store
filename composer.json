{
    "name": "bagisto/bagisto",
    "type": "project",
    "description": "Bagisto Laravel E-Commerce",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-calendar": "*",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-tokenizer": "*",
        "astrotomic/laravel-translatable": "^11.16",
        "barryvdh/laravel-dompdf": "^2.0.0|^3.0",
        "diglactic/laravel-breadcrumbs": "^10.0",
        "elasticsearch/elasticsearch": "^8.10",
        "enshrined/svg-sanitize": "^1.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^4.2",
        "kalnoy/nestedset": "^7.0",
        "khaled.alshamaa/ar-php": "^6.0.0",
        "konekt/concord": "^1.18",
        "laravel/ai": "^0.7.0",
        "laravel/cashier": "^16.0",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.3",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^4.0",
        "mpdf/mpdf": "^8.2",
        "nesbot/carbon": "^3.0",
        "paypal/paypal-server-sdk": "^2.0",
        "pragmarx/google2fa": "^8.0",
        "predis/predis": "^2.2",
        "prettus/l5-repository": "^4.0",
        "pusher/pusher-php-server": "^7.0",
        "razorpay/razorpay": "^2.9",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-responsecache": "^8.4",
        "spatie/laravel-sitemap": "^8.0",
        "stevebauman/purify": "^6.3",
        "stripe/stripe-php": "^17.3",
        "symfony/brevo-mailer": "^7.4",
        "symfony/http-client": "^7.4",
        "web-token/jwt-framework": "^4.1"
    },
    "require-dev": {
        "bagisto/laravel-datafaker": "2.3.*",
        "barryvdh/laravel-debugbar": "^4.3",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.1",
        "laravel/pint": "^1.19",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "files": [
            "packages/EcomForYou/Core/src/Support/legacy-namespace.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
